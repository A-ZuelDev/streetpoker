# Copy this file to .env.alpha and replace every example value before use.
# .env.alpha is ignored by Git. Never commit the populated file.
POSTGRES_DB=streetpoker
POSTGRES_USER=streetpoker
POSTGRES_PASSWORD=replace-with-a-long-random-password
STREETPOKER_DATABASE_URL=postgresql+psycopg://streetpoker:replace-with-a-long-random-password@postgres:5432/streetpoker

# JSON list containing the exact public frontend origin(s).
STREETPOKER_CORS_ORIGINS=["https://play.example.com"]

# Public URL compiled into the browser bundle. This is not a secret.
PUBLIC_API_BASE_URL=https://api.example.com

# Keep loopback bindings when a host reverse proxy terminates TLS.
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8000
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=8080
